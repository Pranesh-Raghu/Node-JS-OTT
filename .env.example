# Copy this file to .env and fill in real values. Never commit .env.
PORT=1000
# Postgres connection string, e.g. from a free Neon/Supabase project:
# postgresql://user:password@host:5432/dbname
DATABASE_URL=
SESSION_SECRET=
NODE_ENV=development
TMDB_API_KEY=
# Only needed to run scripts/fetch-imdb-ratings.js - sign up free at
# https://www.omdbapi.com/apikey.aspx. Not required for the app itself to run.
OMDB_API_KEY=
FGA_API_URL=http://localhost:8080
FGA_STORE_ID=
FGA_MODEL_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Encrypts the OAuth 2.1 signing key's private JWK at rest (AES-256-GCM) -
# see src/auth/oidc/keys.js. Falls back to a dev-only default if unset,
# same as API_KEY_PEPPER; set a real random value in production.
SIGNING_KEY_ENCRYPTION_KEY=
