<!DOCTYPE html>
<html lang="en" data-theme="<%= typeof theme !== 'undefined' ? theme : 'dark' %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My profile</title>
    <link rel="stylesheet" href="/public/css/style.css">
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>

<header>
    <a href="/"><h1>COMICS <span class="accent-text">TV</span></h1></a>
    <nav>
        <a href="/" class="nav-icon-link" title="Home" aria-label="Home"><%- include('../partials/icon', { name: 'home' }) %></a>
        <a href="/watchlist" class="nav-icon-link" title="Watchlist" aria-label="Watchlist"><%- include('../partials/icon', { name: 'bookmark' }) %></a>
        <a href="/account/profile" class="nav-icon-link" title="Profile" aria-label="Profile"><%- include('../partials/icon', { name: 'user' }) %></a>
        <a href="/account/sessions" class="nav-icon-link" title="Sessions" aria-label="Sessions"><%- include('../partials/icon', { name: 'monitor' }) %></a>
        <a href="/account/webhooks" class="nav-icon-link" title="Webhooks" aria-label="Webhooks"><%- include('../partials/icon', { name: 'link' }) %></a>
        <% if (user) { %>
            <a href="/logout" class="nav-icon-link" title="Log out" aria-label="Log out"><%- include('../partials/icon', { name: 'log-out' }) %></a>
        <% } else { %>
            <a href="/login" class="nav-icon-link" title="Log in" aria-label="Log in"><%- include('../partials/icon', { name: 'log-in' }) %></a>
        <% } %>
        <%- include('../partials/theme-toggle') %>
    </nav>
</header>

<main id="main">
    <div class="form-card">
        <h2>Your <span class="accent-text">profile</span></h2>
        <p class="text-muted">Upload a custom profile picture, or leave it unset to use your Gravatar or Google photo.</p>

        <% if (error) { %>
            <p class="error-message"><%= error %></p>
        <% } %>
        <% if (message) { %>
            <p class="success-message"><%= message %></p>
        <% } %>

        <div class="profile-avatar-preview">
            <%- include('../partials/avatar', { email, avatarUrl, username: user, linkToProfile: false }) %>
        </div>

        <form action="/account/profile" method="POST" enctype="multipart/form-data">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="file-upload">
                <input type="file" id="avatar" name="avatar" class="file-upload-input" accept="image/jpeg,image/png,image/webp,image/gif">
                <label for="avatar" class="file-upload-label">
                    <%- include('../partials/icon', { name: 'upload' }) %>
                    <span class="file-upload-text js-file-upload-text">Choose an image&hellip;</span>
                </label>
            </div>
            <p class="text-muted profile-hint">JPEG, PNG, WEBP, or GIF, up to 3 MB.</p>
            <button type="submit">Upload</button>
        </form>

        <% if (avatarUrl) { %>
            <form action="/account/profile" method="POST" class="profile-remove-form">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="removeAvatar" value="1">
                <button type="submit" class="profile-remove-btn">Remove current picture</button>
            </form>
        <% } %>
    </div>
</main>

<footer>
    <p>&copy; <span id="current-year"></span> COMICS <span class="accent-text">TV</span></p>
</footer>

<script src="/public/Javascript/script.js"></script>
</body>
</html>
