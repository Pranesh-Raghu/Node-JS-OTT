<!DOCTYPE html>
<html lang="en" data-theme="<%= typeof theme !== 'undefined' ? theme : 'dark' %>">
<head>
    <meta charset="UTF-8">
    <title>Signup</title>
    <link rel="stylesheet" href="/public/css/style.css">
</head>
<body class="auth-page">
    <a class="skip-link" href="#main">Skip to content</a>
    <main id="main">
        <a class="auth-brand" href="/">COMICS <span class="accent-text">TV</span></a>
        <div class="form-card auth-card">
            <h2>Create your account</h2>
            <p class="form-card-subtitle">Just an email and password to get started.</p>

            <% if (error) { %>
                <p class="error-message"><%= error %></p>
            <% } %>

            <form action="/signup" method="POST">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <label for="email">Email</label>
                <input type="email" id="email" name="email" placeholder="you@example.com" autocomplete="email" required>

                <label for="password">Password</label>
                <input type="password" id="password" name="password" placeholder="Password..." autocomplete="new-password" required>

                <button type="submit">Sign Up</button>
            </form>

            <div class="divider"><span>or</span></div>

            <a class="google-signin-btn" href="/auth/google">
                <svg class="google-icon" viewBox="0 0 48 48" aria-hidden="true" focusable="false">
                    <path fill="#FFC107" d="M43.611 20.083H42V20H24v8h11.303c-1.649 4.657-6.08 8-11.303 8-6.627 0-12-5.373-12-12s5.373-12 12-12c3.059 0 5.842 1.154 7.961 3.039l5.657-5.657C34.046 6.053 29.268 4 24 4 12.955 4 4 12.955 4 24s8.955 20 20 20 20-8.955 20-20c0-1.341-.138-2.65-.389-3.917z"/>
                    <path fill="#FF3D00" d="M6.306 14.691l6.571 4.819C14.655 15.108 18.961 12 24 12c3.059 0 5.842 1.154 7.961 3.039l5.657-5.657C34.046 6.053 29.268 4 24 4 16.318 4 9.656 8.337 6.306 14.691z"/>
                    <path fill="#4CAF50" d="M24 44c5.166 0 9.86-1.977 13.409-5.192l-6.19-5.238A11.91 11.91 0 0 1 24 36c-5.202 0-9.619-3.317-11.283-7.946l-6.522 5.025C9.505 39.556 16.227 44 24 44z"/>
                    <path fill="#1976D2" d="M43.611 20.083H42V20H24v8h11.303a12.04 12.04 0 0 1-4.087 5.571l.003-.002 6.19 5.238C36.971 39.205 44 34 44 24c0-1.341-.138-2.65-.389-3.917z"/>
                </svg>
                <span>Sign up with Google</span>
            </a>

            <p class="auth-switch">Already have an account? <a class="accent-text" href="/login">Log in</a></p>
        </div>
    </main>
</body>
</html>
