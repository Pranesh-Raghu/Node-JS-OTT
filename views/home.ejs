<!DOCTYPE html>
<html lang="en" data-theme="<%= typeof theme !== 'undefined' ? theme : 'dark' %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>COMICS TV</title>
    <link rel="stylesheet" href="/public/css/style.css">
    
</head>
<body data-logged-in="<%= user ? 'true' : 'false' %>">
<a class="skip-link" href="#main">Skip to content</a>

<header>
    <div class="header-top">
        <a class="brand" href="/"><h1>COMICS <span class="accent-text">TV</span></h1></a>
        <nav>
            <a href="/watchlist" class="nav-icon-link" title="Watchlist" aria-label="Watchlist"><%- include('partials/icon', { name: 'bookmark' }) %></a>
            <% if (user) { %>
                <a href="/account/sessions" class="nav-icon-link" title="Sessions" aria-label="Sessions"><%- include('partials/icon', { name: 'monitor' }) %><% if (typeof deviceCount !== 'undefined' && deviceCount > 0) { %><span class="nav-badge"><%= deviceCount %></span><% } %></a>
                <a href="/account/webhooks" class="nav-icon-link" title="Webhooks" aria-label="Webhooks"><%- include('partials/icon', { name: 'link' }) %></a>
                <a href="/logout" class="nav-icon-link" title="Log out" aria-label="Log out"><%- include('partials/icon', { name: 'log-out' }) %></a>
                <%- include('partials/avatar', { email: typeof email !== 'undefined' ? email : null, avatarUrl: typeof avatarUrl !== 'undefined' ? avatarUrl : null, username: user }) %>
            <% } else { %>
                <a href="/login" class="nav-icon-link" title="Log in" aria-label="Log in"><%- include('partials/icon', { name: 'log-in' }) %></a>
            <% } %>
            <%- include('partials/theme-toggle') %>
        </nav>
    </div>

    <!-- Search Bar -->
    <div class="movie-search">
        <div id="search-bar-container">
            <input type="text" id="search-bar" placeholder="Search for movies..." />
        </div>
    </div>
</header>

<main id="main">
    <div class="content">
        <video autoplay muted loop playsinline id="myVideo" class="home">
            <source src="https://res.cloudinary.com/dhrqc7m0s/video/upload/v1736396468/Venom_pdrw5c.mp4" type="video/mp4">
          </video>
                     <h1>Venom
                <span class="accent-text">The Last Dance </span>(2024)</h1><br>

            <h3>After the events of Venom: Let There Be Carnage (2021), Eddie Brock and the symbiote Venom go on the run when they are hunted by both of their worlds.</h3>
         
          </div>
    <section>
        <div class="movie-gallery">
            <% movies.forEach(movie => { %>
                <div class="movie-card">
                    <a class="movie-link" href="/movie/<%= movie.id %>">
                        <img src="<%= movie.poster.startsWith('https://') ? movie.poster : '/' + movie.poster %>" alt="">
                        <span class="movie-title"><%= movie.title %></span>
                    </a>

                    <!-- Watchlist Button (Requires Login) -->
                    <% if (user) { %>
                        <button class="add-to-watchlist-btn" data-id="<%= movie.id %>">Add to Watchlist</button>
                    <% } else { %>
                        <a class="add-to-watchlist-btn" href="/login?redirectTo=<%= encodeURIComponent('/movie/' + movie.id) %>">Add to Watchlist</a>
                    <% } %>

                </div>
            <% }); %>
        </div>

        <% if (pagination && pagination.totalPages > 1) { %>
            <nav class="pagination" aria-label="Movie catalog pages">
                <% if (pagination.hasPrev) { %>
                    <a class="pagination-link" href="/?page=<%= pagination.page - 1 %>">&laquo; Prev</a>
                <% } %>
                <span class="pagination-status">Page <%= pagination.page %> of <%= pagination.totalPages %></span>
                <% if (pagination.hasNext) { %>
                    <a class="pagination-link" href="/?page=<%= pagination.page + 1 %>">Next &raquo;</a>
                <% } %>
            </nav>
        <% } %>
    </section>
</main>

<footer>
    <p>&copy; <span id="current-year"></span> COMICS <span class="accent-text">TV</span></p>
</footer>

<script src="/public/Javascript/script.js"></script>

</body>
</html>
