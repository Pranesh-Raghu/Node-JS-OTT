<!DOCTYPE html>
<html lang="en" data-theme="<%= typeof theme !== 'undefined' ? theme : 'dark' %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= video.title %></title>
    <link rel="stylesheet" href="/public/css/style.css">
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>

<header>
    <h1 class="accent-text"><%= video.title %></h1>
    <nav>
        <a href="/" class="nav-icon-link" title="Home" aria-label="Home"><%- include('partials/icon', { name: 'home' }) %></a>
        <a href="/watchlist" class="nav-icon-link" title="Watchlist" aria-label="Watchlist"><%- include('partials/icon', { name: 'bookmark' }) %></a>
        <% if (user) { %>
            <a href="/logout" class="nav-icon-link" title="Log out" aria-label="Log out"><%- include('partials/icon', { name: 'log-out' }) %></a>
        <% } else { %>
            <a href="/login" class="nav-icon-link" title="Log in" aria-label="Log in"><%- include('partials/icon', { name: 'log-in' }) %></a>
        <% } %>
        <%- include('partials/theme-toggle') %>
    </nav>
</header>

<main class="video-player-container" id="main">
    <% if (video.type === 'youtube') { %>
        <p class="trailer-note">Official trailer</p>
        <div class="video-embed">
            <iframe
                src="https://www.youtube.com/embed/<%= video.youtubeKey %>"
                title="<%= video.title %> trailer"
                frameborder="0"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen>
            </iframe>
        </div>
    <% } else { %>
        <video id="video" controls preload="metadata">
            <source src="<%= video.src %>" type="video/mp4">
            Your browser does not support the video tag.
        </video>
    <% } %>
</main>

<footer>
    <p>&copy; <span id="current-year"></span> COMICS <span class="accent-text">TV</span></p>
</footer>



<script src="/public/Javascript/script.js"></script>

</body>
</html>
