<!-- admin.ejs -->
<!DOCTYPE html>
<html lang="en" data-theme="<%= typeof theme !== 'undefined' ? theme : 'dark' %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/public/css/style.css">
    <title>Admin Panel</title>
</head>
<body class="admin-page">
    <a class="skip-link" href="#main">Skip to content</a>
    <header>
        <div class="header-top">
            <h1 class="accent-text">ADMIN PANEL</h1>
            <nav>
                <%- include('partials/theme-toggle') %>
            </nav>
        </div>
    </header>
    <br>
    <main id="main">
        <div class="form-card">
            <h2>MOVIE</h2>
            <form action="/admin/add-movie" method="POST">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <label for="title">Title:</label>
                <input type="text" id="title" name="title" required><br>
                <label for="releaseDate">Release Date:</label>
                <input type="date" id="releaseDate" name="releaseDate" required><br>
                <label for="poster">Poster URL:</label>
                <input type="text" id="poster" name="poster" required><br>
                <label for="cast">Cast (JSON):</label>
                <textarea id="cast" name="cast" required></textarea><br>
                <label for="crew">Crew (JSON):</label>
                <textarea id="crew" name="crew" required></textarea><br>
                <button type="submit">Add Movie</button>
            </form>
        </div>
        <hr>
        <div class="form-card">
            <h2>VIDEO</h2>
            <form action="/admin/upload-video" method="POST">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <label for="titleId">Movie:</label>
                <select id="titleId" name="titleId" required>
                    <option value="" disabled selected>Select a movie&hellip;</option>
                    <% titles.forEach(t => { %>
                        <option value="<%= t.id %>"><%= t.title %></option>
                    <% }); %>
                </select><br>
                <label for="videoTitle">Video label:</label>
                <input type="text" id="videoTitle" name="title" required><br>
                <label for="videoLink">Video URL:</label>
                <input type="text" id="videoLink" name="videoLink" required><br>
                <button type="submit">Upload Video</button>
            </form>
        </div>
        <br>
    </main>
</body>
</html>
