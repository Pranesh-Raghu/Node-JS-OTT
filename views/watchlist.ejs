<!DOCTYPE html>
<html lang="en" data-theme="<%= typeof theme !== 'undefined' ? theme : 'dark' %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Watchlist</title>
    <link rel="stylesheet" href="/public/css/style.css">
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>

<header>
    <h1>YOUR <span class="accent-text">WATCHLIST</span></h1>
    <nav>
        <a href="/" class="nav-icon-link" title="Home" aria-label="Home"><%- include('partials/icon', { name: 'home' }) %></a>
        <a href="/watchlist" class="nav-icon-link" title="Watchlist" aria-label="Watchlist"><%- include('partials/icon', { name: 'bookmark' }) %></a>
        <% if (user) { %>
            <a href="/logout" class="nav-icon-link" title="Log out" aria-label="Log out"><%- include('partials/icon', { name: 'log-out' }) %></a>
        <% } else { %>
            <a href="/login" class="nav-icon-link" title="Log in" aria-label="Log in"><%- include('partials/icon', { name: 'log-in' }) %></a>
        <% } %>
        <%- include('partials/theme-toggle') %>
    </nav>
    <div class="movie-search">
        <div id="search-bar-container">
            <input type="text" id="search-bar" placeholder="Search for a movie...">
        </div>
    </div>        
</header>

<main id="main">
    <%# The watchlist is stored client-side in localStorage (see
        public/Javascript/script.js), not server-side - req.session.watchlist
        is never actually written to, so a server-rendered branch here was
        always empty and left a stray blank line above whatever script.js
        appended into this container. script.js populates everything,
        including the empty state, on load. %>
    <div class="watchlist-container"></div>
</main>

<footer>
    <p>&copy; <span id="current-year"></span> COMICS <span class="accent-text">TV</span></p>
</footer>

<script src="/public/Javascript/script.js"></script>

</body>
</html>
