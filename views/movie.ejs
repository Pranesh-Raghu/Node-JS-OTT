<!DOCTYPE html>
<html lang="en" data-theme="<%= typeof theme !== 'undefined' ? theme : 'dark' %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= movie.title %></title>
    <link rel="icon" href="<%= movie.poster %>">
    <link rel="stylesheet" href="/public/css/style.css">
</head>
<body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header>
        <h1 class="accent-text"><%= movie.title %></h1>
        <nav>
            <a href="/">HOME</a>
            <a href="/watchlist">WATCHLIST</a>
            <% if (user) { %>
                <a href="/logout">LOGOUT</a>
            <% } else { %>
                <a href="/login">LOGIN</a>
            <% } %>
            <%- include('partials/theme-toggle') %>
        </nav>
    </header>

    <main id="main">
        <div class="movie-details">
            <img src="<%= movie.poster %>" alt="<%= movie.title %>">
            <h2>Release Date: <%= movie.releaseDate %></h2>
            <p>Cast: 
                <% movie.cast.forEach(castMember => { %>
                    <span><%= castMember.name %> as <%= castMember.role %></span><br>
                <% }); %>
            </p>
            <p>Crew:
                <% movie.crew.forEach(crewMember => { %>
                    <span><%= crewMember.name %> (<%= crewMember.role %>)</span><br>
                <% }); %>
            </p>

            <!-- Watch Now Button -->
            <% if (hasVideo) { %>
                <% if (user) { %>
                    <a class="watch-now-btn" href="/video/<%= movie.id %>">Watch Now</a>
                <% } else { %>
                    <a class="watch-now-btn" href="/login?redirectTo=<%= encodeURIComponent(`/video/${movie.id}`) %>">Watch Now</a>
                <% } %>
            <% } else { %>
                <p class="no-video-message">No video available yet for this title.</p>
            <% } %>

        </div>
    </main>

    <footer>
        <p>&copy; <span id="current-year"></span> COMICS <span class="accent-text">TV</span></p>
    </footer>
    <script src="/public/javascript/script.js"></script>
</body>
</html>
