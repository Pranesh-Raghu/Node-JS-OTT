<%# Expects locals: email (string|null), avatarUrl (string|null, a
    user-uploaded custom picture), username (string), linkToProfile
    (boolean, default true - set false when this partial is already inside
    the profile page itself, so the preview there isn't a pointless
    self-link).
    Priority: Gravatar (if email has one registered) first, then a custom
    uploaded avatarUrl, then the first-letter fallback.

    The initial-letter span is always the element actually rendered server
    side - public/Javascript/script.js preloads each candidate URL with a
    detached Image() and only swaps the visible element for a real <img>
    once one is confirmed to load. This means a user with no Gravatar
    picture registered (the common case) never sees a flash of the
    browser's native broken-image icon, since no <img> pointed at a 404
    is ever inserted into the visible DOM. %>
<% const shouldLink = typeof linkToProfile === 'undefined' || linkToProfile; %>
<%
    const wrapperAttrs = `class="avatar-wrapper js-avatar-chain"
      data-fallback-initial="${avatarInitial(username)}"
      data-fallback-color="${avatarColor(username)}"
      data-gravatar-url="${(typeof email !== 'undefined' && email) ? gravatarUrl(email) : ''}"
      data-avatar-url="${(typeof avatarUrl !== 'undefined' && avatarUrl) ? avatarUrl : ''}"
      data-alt="${username}'s profile picture"`;
%>
<% if (shouldLink) { %>
    <a href="/account/profile" title="Profile" aria-label="Profile">
        <span <%- wrapperAttrs %>>
            <span class="avatar avatar-initial" style="background-color: <%= avatarColor(username) %>"><%= avatarInitial(username) %></span>
        </span>
    </a>
<% } else { %>
    <span <%- wrapperAttrs %>>
        <span class="avatar avatar-initial" style="background-color: <%= avatarColor(username) %>"><%= avatarInitial(username) %></span>
    </span>
<% } %>
